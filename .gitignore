# Reproducible exports; keep the base directory in Git.
/exports/*
!/exports/.gitkeep

# Disposable agent work and Git worktrees.
.codex-tmp/
.worktrees/

# Saved-design backups.
*.bak

# Optional Python checking helpers.
__pycache__/
*.py[cod]
.venv/

# Downloaded third-party CAD; non-commercial internal-use terms.
/models/auer_euroboxes/reference/

# Assembly embeds the restricted GrabCAD reference geometry.
/models/eurobox_cupboard/cupboard.solidcraft
/models/eurobox_cupboard/cupboard_slide.solidcraft
